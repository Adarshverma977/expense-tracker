
# Application
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=1d

# OTP verification
OTP_SECRET=replace_with_a_secure_random_secret

# Frontend
CLIENT_URL=http://localhost:5173

# Email verification
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=Expense Tracker <your_verified_sender_email>